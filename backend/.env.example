# Copy to .env and fill in values

# MongoDB Connection String
# For local: mongodb://localhost:27017
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net
MONGODB_URI=

# Cloudinary Configuration (for image hosting)
# Get from: https://cloudinary.com/console
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
CLOUDINARY_NAME=

# JWT Secret (use a strong random string in production)
JWT_SECRET=

# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth Configuration
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console
# Use the same value in frontend as VITE_GOOGLE_CLIENT_ID
# Add authorized JavaScript origins: http://localhost:5174 and your production URLs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payment Gateway
# Get from: https://dashboard.razorpay.com/app/keys
# Use Test keys for development, Live keys for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Configuration (for email verification and password reset)
# For Gmail: Use App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
# For other providers, adjust host and port accordingly
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

# Frontend URL (for CORS and email links)
# Local: http://localhost:5174
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5174

# SMS OTP (optional – for mobile verification; if not set, OTP is logged to console)
# Get from: https://www.twilio.com/console
# Twilio phone number must be in E.164 format (e.g. +1234567890)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Node Environment
NODE_ENV=development
