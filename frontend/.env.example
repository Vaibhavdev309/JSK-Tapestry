# Copy to .env and fill in values

# Backend API URL
# Local: http://localhost:4000
# Production: https://your-backend.onrender.com (or your Render backend URL)
VITE_BACKEND_URL=http://localhost:4000

# Google Sign-In: OAuth 2.0 Client ID (Web application) from Google Cloud Console
# Same value as backend GOOGLE_CLIENT_ID
# Add Authorized JavaScript origins:
#   - http://localhost:5174 (local)
#   - https://your-vercel-app.vercel.app (production)
#   - https://your-custom-domain.com (if using custom domain)
VITE_GOOGLE_CLIENT_ID=

# Image URLs (Optional - defaults to /images/ folder in public directory)
# Use these if you want to host images on a CDN or use custom URLs
# Leave empty to use images from public/images/ folder
# VITE_LOGO_URL=/images/logo.png
# VITE_HERO_IMG_URL=/images/hero_img.png
# VITE_ABOUT_IMG_URL=/images/about_img.png
# VITE_CONTACT_IMG_URL=/images/contact_img.png
# Or use CDN URLs:
# VITE_HERO_IMG_URL=https://your-cdn.com/images/hero_img.png
