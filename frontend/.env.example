# Copy to .env and fill in values

VITE_BACKEND_URL=http://localhost:4000

# Google Sign-In: OAuth 2.0 Client ID (Web application) from Google Cloud Console. Same value as backend GOOGLE_CLIENT_ID. Add Authorized JavaScript origins, e.g. http://localhost:5173 and your production URL.
VITE_GOOGLE_CLIENT_ID=663088328123-n9en7qklbimbqdm7o1lt9j1l8dg5oea2.apps.googleusercontent.com

# Image URLs (Optional - defaults to /images/ folder in public directory)
# Use these if you want to host images on a CDN or use custom URLs
# Leave empty to use images from public/images/ folder
# VITE_LOGO_URL=/images/logo.png
# VITE_HERO_IMG_URL=/images/hero_img.png
# VITE_ABOUT_IMG_URL=/images/about_img.png
# VITE_CONTACT_IMG_URL=/images/contact_img.png
# Or use CDN URLs:
# VITE_HERO_IMG_URL=https://your-cdn.com/images/hero_img.png
